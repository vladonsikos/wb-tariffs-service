# Wildberries API
WB_API_TOKEN=your_wb_api_token_here

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Google Sheets (путь к файлу с сервисным аккаунтом)
GOOGLE_SERVICE_ACCOUNT_PATH=/app/google-credentials.json

# Google Sheets IDs через запятую (N таблиц)
GOOGLE_SPREADSHEET_IDS=spreadsheet_id_1,spreadsheet_id_2

# Расписание cron (каждый час)
CRON_SCHEDULE=0 * * * *
